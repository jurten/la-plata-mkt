# Public values required while prerendering production pages.
# Repeat PUBLIC_SITE_URL and the Turnstile site key as Worker runtime variables.
PUBLIC_SITE_URL=https://www.your-domain.example

# Keep false until client names and factual narratives are authorized for publication.
PUBLIC_CASE_STUDIES_APPROVED=false
PUBLIC_TURNSTILE_SITE_KEY=

# Runtime email and antispam values belong in .dev.vars locally and in
# Cloudflare Worker Variables and Secrets in production; see .dev.vars.example.
