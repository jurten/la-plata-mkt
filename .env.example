# Trusted public origin (required before a production build).
PUBLIC_SITE_URL=https://www.your-domain.example

# Keep false until client names and factual narratives are authorized for publication.
PUBLIC_CASE_STUDIES_APPROVED=false

# Live email mode requires the four values marked REQUIRED.
RESEND_API_KEY= # REQUIRED
CONTACT_FROM="La Plata Marketing <hola@your-domain.example>" # REQUIRED
CONTACT_TO=laplatamarketing@gmail.com # Optional; this is the built-in default
TURNSTILE_SECRET= # REQUIRED
PUBLIC_TURNSTILE_SITE_KEY= # REQUIRED
