{
  "name": "la-plata-marketing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && node scripts/verify-build.mjs",
    "preview": "astro preview",
    "start": "astro preview",
    "check": "astro check",
    "verify": "npm run test && npm run test:e2e && npm run build",
    "visual:audit": "node scripts/redesign-audit.mjs",
    "assets:favicon": "python scripts/generate-favicon.py",
    "assets:og": "node scripts/generate-og.mjs",
    "assets:brand": "npm run assets:favicon && npm run assets:og",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "cf:types": "wrangler types",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.2",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "astro": "^7.3.3",
    "gsap": "^3.15.1",
    "three": "^0.187.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@axe-core/playwright": "latest",
    "@playwright/test": "latest",
    "@types/node": "latest",
    "@types/three": "^0.186.0",
    "parse5": "8.0.1",
    "typescript": "latest",
    "vitest": "latest",
    "wrangler": "^4.135.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260918.1": true
  }
}
