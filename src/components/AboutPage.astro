---
import SiteLayout from './SiteLayout.astro';
import Icon from './Icon.astro';
import { getTranslator } from '../lib/i18n';
import { teamMembers } from '../lib/team';
import '../styles/about-page.css';
const t = getTranslator(Astro.url.pathname);
const values = [
  { kind: 'together', title: 'Combinar miradas', description: 'Cruzamos creatividad, marketing y tecnología. Cada disciplina aporta una perspectiva distinta para encontrar respuestas que una sola mirada no alcanza a ver.' },
  { kind: 'focus', title: 'Entender el problema', description: 'Antes de proponer, escuchamos. Nos involucramos en el contexto de tu negocio para comprender qué necesitás resolver y por qué.' },
  { kind: 'solutions', title: 'Articular soluciones', description: 'Conectamos distintas áreas para resolver problemas complejos. Cuidamos cada decisión para que el resultado sea coherente, profesional y funcione como un todo.' },
];
function lightPath(kind: string) {
  return Array.from({ length: 128 }, (_, index) => {
    const angle = index / 128 * Math.PI * 2;
    const radius = kind === 'together' ? 80 + 14.4 * Math.cos(angle * 4) : 83.2 + 12.8 * Math.cos((angle - Math.PI / 2) * 3);
    const x = kind === 'focus' ? Math.cos(angle) * 96 : Math.cos(angle) * radius;
    const y = kind === 'focus' ? Math.sin(angle) * 68.8 : Math.sin(angle) * radius;
    return `${index ? 'L' : 'M'}${(200 + x).toFixed(2)},${(160 - y).toFixed(2)}`;
  }).join(' ') + 'Z';
}
---
<SiteLayout title={`${t('Nosotros')} | La Plata Marketing`} description={t('Conocé a Joaquín, Santiago y Justina y cómo conectamos creatividad, marketing y tecnología.')}>
  <div class="about-page" data-about-page data-no-split>
    <section class="about-values wrap" id="valores" aria-labelledby="about-values-title">
      <header class="about-values__header">
        <h1 id="about-values-title">{t('Lo que nos mueve')}</h1>
        <p>{t('Combinar miradas para entender mejor y construir soluciones integrales')}</p>
      </header>
      <div class="about-values__grid">
        {values.map(value => <article class={`about-value about-value--${value.kind}`}>
          <div class="about-value__visual" aria-hidden="true" data-value-visual>
            <svg class="about-value__still" viewBox="0 0 400 320" fill="none" focusable="false">
              <defs>
                <path id={`value-form-${value.kind}`} d={lightPath(value.kind)} />
                <filter id={`value-glow-${value.kind}`} x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="7" /></filter>
                <linearGradient id={`value-ink-${value.kind}`} x1="0" y1="0" x2="1" y2="1"><stop stop-color="#b7d7ee" /><stop offset=".45" stop-color="#487aff" /><stop offset="1" stop-color="#1536f1" /></linearGradient>
              </defs>
              <use href={`#value-form-${value.kind}`} stroke="#254bff" stroke-width="18" opacity=".7" filter={`url(#value-glow-${value.kind})`} />
              <use href={`#value-form-${value.kind}`} stroke={`url(#value-ink-${value.kind})`} stroke-width="3" />
              {value.kind !== 'together' && <circle cx="200" cy="160" r={value.kind === 'focus' ? 4 : 8} fill="#b7d7ee" />}
            </svg>
          </div>
          <div class="about-value__caption"><h3>{t(value.title)}</h3><p>{t(value.description)}</p></div>
        </article>)}
      </div>
    </section>

    <section class="about-team wrap" id="nosotros" aria-labelledby="about-team-title">
      <header class="about-team__heading"><Icon name="down" /><h2 id="about-team-title">{t('Conocé al equipo')}</h2></header>
      <div class="about-team__portraits">
        {teamMembers.map(member => <article id={`team-${member.id}`} class="team-profile about-person" aria-labelledby={`name-${member.id}`}>
          <div class="about-person__portrait">
            <img src={member.portrait!} alt={t('Retrato de {name}', { name: member.name })} width="960" height={member.id === 'joaquin-laumann' ? 720 : member.id === 'santiago-laumann' ? 1248 : 1011} loading="lazy" decoding="async" style={{ 'object-position': member.portraitPosition ?? '50% 35%' }} />
          </div>
          <div class="about-person__caption"><h3 id={`name-${member.id}`}>{member.name}</h3><p>{t(member.role)}</p>{member.description && <p>{t(member.description)}</p>}</div>
        </article>)}
      </div>
    </section>

  </div>
</SiteLayout>
<script>import '../scripts/about-page';</script>
