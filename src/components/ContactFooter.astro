---
import { getTranslator } from '../lib/i18n';
const t = getTranslator(Astro.url.pathname);
import BrandLogo from './BrandLogo.astro';
import Icon from './Icon.astro';
interface Props {
  whatsappHref: string;
  whatsappDisplay: string;
  contactEmail: string;
  privacyHref: string;
}
const { whatsappHref, whatsappDisplay, contactEmail, privacyHref } = Astro.props;
---
<footer class="site-footer closing-footer" id="contacto" aria-labelledby="contact-title">
  <div class="wrap">
    <div class="footer-directory">
      <div class="footer-direct" role="group" aria-label={t("Canales de contacto directo")}>
        <h2 id="contact-title">{t("Hablemos")}</h2>
        <p>{t("La primera reunión es gratuita.")}</p>
        <a class="footer-whatsapp" href={whatsappHref} aria-label={t("Escribir a La Plata Marketing por WhatsApp al {phone}", { phone: whatsappDisplay })}>
          <span>{t("Por WhatsApp")}<strong>{whatsappDisplay}</strong></span><Icon />
        </a>
        <a class="footer-email" href={`mailto:${contactEmail}`} aria-label={t("Escribir por email a {email}", { email: contactEmail })}><span>{contactEmail}</span><Icon /></a>
      </div>
      <div class="footer-location">
        <h2>{t("Desde La Plata")}</h2>
        <p>{t("Trabajamos de forma remota con negocios de otras ciudades. Para proyectos locales, también podemos coordinar encuentros presenciales.")}</p>
      </div>
      <nav class="footer-explore" aria-label={t("Explorá La Plata Marketing")}>
        <h2>{t("Navegá")}</h2>
        <a href="#soluciones">{t("Nuestro enfoque")}</a>
        <a href="#como-trabajamos">{t("Cómo trabajamos")}</a>
        <a href="#trabajo">{t("Trabajos")}</a>
        <a href="#nosotros">{t("Nosotros")}</a>
        <a href={`mailto:${contactEmail}`} aria-label={t("Contacto por email")}>{t("Contacto")} <Icon /></a>
        <a href={privacyHref}>{t("Privacidad")}</a>
      </nav>
    </div>
    <div class="footer-signoff">
      <a class="footer-brand" href="#inicio" aria-label={t("La Plata Marketing, volver arriba")}><BrandLogo variant="horizontal" /></a>
    </div>
    <div class="footer-bottom">
      <span>© 2026 LPM / La Plata, Argentina</span>
      <span id="mode-label">{t("Identidad visual / Sistema automático")}</span>
      <a href="#inicio">{t("Volver arriba")} <Icon name="arrow" /></a>
    </div>
  </div>
</footer>
<script>import '../scripts/footer-arrival';</script>
