---
import BrandLogo from './BrandLogo.astro';
import Icon from './Icon.astro';
interface Props {
  whatsappHref: string;
  whatsappDisplay: string;
  contactEmail: string;
  privacyHref: string;
}
const { whatsappHref, whatsappDisplay, contactEmail, privacyHref } = Astro.props;
---
<footer class="site-footer closing-footer" id="contacto" aria-labelledby="contact-title">
  <div class="wrap">
    <div class="footer-directory">
      <div class="footer-direct" role="group" aria-label="Canales de contacto directo">
        <h2 id="contact-title">Hablemos</h2>
        <p>La primera reunión es gratuita.</p>
        <a class="footer-whatsapp" href={whatsappHref} aria-label={`Escribir a La Plata Marketing por WhatsApp al ${whatsappDisplay}`}>
          <span>Por WhatsApp<strong>{whatsappDisplay}</strong></span><Icon />
        </a>
        <a class="footer-email" href={`mailto:${contactEmail}`} aria-label={`Escribir por email a ${contactEmail}`}><span>{contactEmail}</span><Icon /></a>
      </div>
      <div class="footer-location">
        <h2>Desde La Plata</h2>
        <p>Trabajamos de forma remota con negocios de otras ciudades. Para proyectos locales, también podemos coordinar encuentros presenciales.</p>
      </div>
      <nav class="footer-explore" aria-label="Explorá La Plata Marketing">
        <h2>Navegá</h2>
        <a href="#soluciones">Nuestro enfoque</a>
        <a href="#como-trabajamos">Cómo trabajamos</a>
        <a href="#trabajo">Trabajos</a>
        <a href="#nosotros">Nosotros</a>
        <a href={`mailto:${contactEmail}`} aria-label="Contacto por email">Contacto <Icon /></a>
        <a href={privacyHref}>Privacidad</a>
      </nav>
    </div>
    <div class="footer-signoff">
      <a class="footer-brand" href="#inicio" aria-label="La Plata Marketing, volver arriba"><BrandLogo variant="horizontal" /></a>
    </div>
    <div class="footer-bottom">
      <span>© 2026 LPM / La Plata, Argentina</span>
      <span id="mode-label">Identidad visual / Sistema automático</span>
      <a href="#inicio">Volver arriba <Icon name="arrow" /></a>
    </div>
  </div>
</footer>
<script>import '../scripts/footer-arrival';</script>
