---
import { paletteOptions, type PaletteId } from '../lib/palettes';

interface Props {
  activePalette: PaletteId;
  exitHref: string;
}

const { activePalette, exitHref } = Astro.props;
---

<aside class="palette-lab" data-palette-lab aria-label="Laboratorio de paletas">
  <button
    class="palette-lab-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="palette-lab-panel"
    data-palette-toggle
  >
    <span>Paletas</span>
    <small>{paletteOptions.find(({ id }) => id === activePalette)?.name}</small>
  </button>

  <section class="palette-lab-panel" id="palette-lab-panel" hidden data-palette-panel>
    <header>
      <div>
        <strong>Sistema de tintas</strong>
        <small>Cuatro jerarquías inspiradas en impresión editorial.</small>
      </div>
      <a href={exitHref}>Salir</a>
    </header>

    <div class="palette-lab-options">
      {paletteOptions.map((palette) => (
        <button
          class="palette-option"
          type="button"
          data-palette-option={palette.id}
          data-theme-color={palette.colors.primary}
          aria-pressed={palette.id === activePalette ? 'true' : 'false'}
          style={`--swatch-ink:${palette.colors.ink};--swatch-paper:${palette.colors.paper};--swatch-primary:${palette.colors.primary};--swatch-highlight:${palette.colors.highlight};--swatch-secondary:${palette.colors.secondary};--swatch-signal:${palette.colors.signal}`}
        >
          <span class="palette-option-swatches" aria-hidden="true">
            <i></i><i></i><i></i><i></i><i></i><i></i>
          </span>
          <span>
            <strong>{palette.name}</strong>
            <small>{palette.description}</small>
          </span>
        </button>
      ))}
    </div>

    <footer>
      <button type="button" data-copy-palette-link>Copiar enlace</button>
      <span role="status" aria-live="polite" data-palette-status></span>
    </footer>
  </section>
</aside>
