---
import SiteLayout from './SiteLayout.astro';
import { getTranslator, getLocale } from '../lib/i18n';
import { pagePath } from '../lib/navigation';
const t = getTranslator(Astro.url.pathname);
const contactHref = pagePath('contact', getLocale(Astro.url.pathname));
---
<SiteLayout title={t('Privacidad | La Plata Marketing')} description={t('C\u00f3mo La Plata Marketing recibe, utiliza y protege la informaci\u00f3n que compart\u00eds al contactarnos.')} floating={false}>
  <div class="wrap"><div class="legal-content"><h1>{t('Privacidad')}</h1><p>{t('Última actualización: noviembre de 2026')}</p>
      <section class="legal-sections" aria-label={t("Detalles del tratamiento de datos")}>
        <article>
          <h2>{t("Quién recibe la consulta")}</h2>
          <p> {t("Justina Rosa Guiñazú, responsable de La Plata Marketing, recibe y responde las consultas enviadas desde este sitio. El canal de contacto para temas de privacidad es")} <a href="mailto:ceo@laplatamarketing.com">ceo@laplatamarketing.com</a>.
          </p>
        </article>

        <article>
          <h2>{t("Qué datos recibimos")}</h2>
          <p>{t('El formulario solicita nombre, email, mensaje y aceptación de privacidad. Empresa y teléfono son opcionales. También recibimos los datos que decidas compartir por email o WhatsApp.')}</p>
        </article>

        <article>
          <h2>{t("Para qué los usamos")}</h2>
          <p> {t("Para recibir, analizar y responder tu consulta; mantener la conversación comercial que vos iniciaste; y proteger el sitio contra envíos automatizados o abusivos.")} </p>
        </article>

        <article>
          <h2>{t("Con quién pueden procesarse")}</h2>
          <p>{t('Cloudflare aloja y protege el sitio; Turnstile verifica los envíos para prevenir abuso. Resend entrega la consulta y su confirmación por email cuando el envío está configurado. Google Workspace puede procesar el correo recibido. Si elegís WhatsApp, Meta y WhatsApp procesan los datos según sus propias políticas.')}</p>
        </article>

        <article>
          <h2>{t("Cuánto tiempo se conservan")}</h2>
          <p> {t("Conservamos los datos mientras resulte necesario para responder y dar seguimiento a tu consulta. Cuando ya no sean necesarios, los eliminamos o anonimizamos, salvo que una obligación legal o la necesidad de ejercer o defender derechos requiera conservarlos por más tiempo.")} </p>
        </article>

        <article>
          <h2>{t("Tus decisiones y derechos")}</h2>
          <p> {t("Podés pedir acceso, corrección o eliminación de tus datos y retirar tu consentimiento escribiendo a")} <a href="mailto:ceo@laplatamarketing.com">ceo@laplatamarketing.com</a>{t(". Podés contactarnos directamente por email o WhatsApp.")} </p>
        </article>
      </section>
      <article><h2>{t('Borrador al cambiar de idioma')}</h2><p>{t('Solo al cambiar de idioma, el formulario guarda un borrador temporal en esta pestaña para recuperar tus datos en la página equivalente. Se elimina al recuperarlo y caduca a los treinta minutos. Este traslado no envía los datos a terceros. En modo demostración, el formulario no envía correo real.')}</p></article>

<a class="button button-primary" href={contactHref}>{t('Volver a contacto')}</a></div></div>
</SiteLayout>
