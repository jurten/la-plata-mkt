---
import '../styles/site-transmission.css';
---
<div class="site-transmission" data-site-transmission data-transmission-state="static" data-beam="inactive" data-signal-phase="locked" aria-hidden="true">
  <svg class="transmission-definitions" width="0" height="0" focusable="false">
    <defs>
      <clipPath id="site-crt-cutout" clipPathUnits="userSpaceOnUse"><path clip-rule="evenodd" data-crt-cutout /></clipPath>
    </defs>
  </svg>
  <canvas class="transmission-static"></canvas>
</div>
<button class="transmission-toggle" type="button" data-transmission-toggle aria-pressed="true" hidden>
  <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M5 3v10M11 3v10" stroke="currentColor" stroke-width="2" /></svg>
  <span>Pausar interferencia</span>
</button>
<script>
  import '../scripts/site-transmission';
</script>
