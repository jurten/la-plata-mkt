---
import OptionWheel from './OptionWheel.astro';
import Icon from './Icon.astro';
import portraitPlaceholder from '../assets/lpm-visitor.png';
import { teamMembers } from '../lib/team';
---

<section class="team-roster" aria-label="Equipo" data-team-roster>
  <div class="team-roster__stage">
    <div class="team-roster__selector">
      <div class="team-roster__wheel">
        <OptionWheel id="team-wheel" label="Integrantes del equipo" items={teamMembers.map(member => member.name)} targets={teamMembers.map(member => `team-${member.id}`)} defaultSelected={1} />
      </div>
      <div class="team-roster__navigation" data-team-navigation hidden>
        <p id="team-wheel-hint">Arrastrá o elegí un nombre</p>
        <div class="team-roster__arrows">
          <button type="button" data-team-previous aria-label="Ver integrante anterior" aria-controls="team-wheel"><Icon name="down" /></button>
          <button type="button" data-team-next aria-label="Ver siguiente integrante" aria-controls="team-wheel"><Icon name="down" /></button>
        </div>
      </div>
    </div>

    <div class="team-roster__portraits" data-team-panels>
      {teamMembers.map((member, index) => (
        <figure id={`team-${member.id}`} class:list={['team-roster__profile', { 'is-active': index === 1 }]} data-team-profile aria-labelledby={`team-name-${member.id}`}>
          <div class="team-roster__photo">
            {member.portrait ? (
              <img src={member.portrait} alt={`Retrato de ${member.name}`} width="640" height="760" loading="lazy" decoding="async" style={{ 'object-position': member.portraitPosition ?? '50% 35%' }} />
            ) : (
              <img src={portraitPlaceholder.src} alt="Retrato alienígena de relleno, provisorio" width="640" height="760" loading="lazy" decoding="async" style="object-position: right" />
            )}
            {!member.portrait && <span class="team-roster__placeholder-note">Retrato provisorio</span>}
          </div>
          <figcaption>
            <h3 id={`team-name-${member.id}`} class="team-roster__name" data-team-current-name>{member.name}</h3>
            <p class="team-roster__role" data-team-current-role>{member.role}</p>
            {member.description && <p class="team-roster__bio">{member.description}</p>}
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
  <p class="sr-only" aria-live="polite" aria-atomic="true" data-team-status></p>
</section>

<script>
  import { initTeamRosters } from '../scripts/team-roster';
  initTeamRosters();
</script>

<style>
  .team-roster { color: var(--ink); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .team-roster__stage { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); gap: clamp(32px, 6vw, 96px); align-items: center; }
  .team-roster__selector, .team-roster__wheel { min-width: 0; }
  .team-roster__navigation { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-top: 24px; border-top: 1px solid var(--line); color: var(--muted); font-size: 14px; }
  .team-roster__navigation[hidden] { display: none; }
  .team-roster__arrows { display: flex; gap: 8px; }
  .team-roster__arrows button { display: grid; width: 48px; height: 48px; place-items: center; border: 1px solid var(--line); border-radius: 50%; background: transparent; color: var(--ink); cursor: pointer; transition: background-color 180ms ease-out, color 180ms ease-out; }
  .team-roster__arrows button:first-child { transform: rotate(180deg); }
  .team-roster__arrows button:hover:enabled { background: var(--blue); color: #fff; }
  .team-roster__arrows button:disabled { opacity: 0.35; cursor: default; }
  .team-roster__arrows button:focus-visible { outline: 2px solid var(--blue-text); outline-offset: 4px; }

  .team-roster__portraits { display: grid; gap: 40px; min-width: 0; }
  .team-roster__profile { min-width: 0; margin: 0; scroll-margin-top: 120px; }
  .team-roster__profile[hidden] { display: none; }
  .team-roster__photo { position: relative; aspect-ratio: 4 / 4.5; overflow: hidden; background: #020307; }
  .team-roster__photo img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .team-roster__placeholder-note { position: absolute; right: 16px; bottom: 16px; padding: 6px 10px; border-radius: 4px; background: #020307; color: #eef2ff; font-size: 12px; line-height: 1.4; }
  .team-roster__profile figcaption { display: grid; gap: 6px; padding-top: 20px; }
  .team-roster__name { font-family: var(--display); font-weight: 700; font-size: clamp(24px, 2.4vw, 32px); line-height: 1.12; letter-spacing: -0.025em; }
  .team-roster__role { color: var(--blue-text); font-size: 16px; }
  .team-roster__bio { max-width: 45ch; margin-top: 10px; color: var(--muted); }

  @media (max-width: 1000px) {
    .team-roster__stage { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 32px; }
  }
  @media (max-width: 700px) {
    .team-roster__stage { grid-template-columns: 1fr; gap: 32px; }
    .team-roster__navigation { padding-top: 12px; font-size: 13px; }
    .team-roster__photo { aspect-ratio: 1; }
    .team-roster__profile figcaption { padding-top: 16px; }
  }
  @media (prefers-reduced-motion: reduce) { .team-roster__arrows button { transition: none; } }
  @media (forced-colors: active) {
    .team-roster__arrows button { border-color: ButtonText; }
    .team-roster__placeholder-note { background: Canvas; color: CanvasText; }
  }
</style>
