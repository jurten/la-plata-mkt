---
import Icon from './Icon.astro';
import portraitPlaceholder from '../assets/lpm-visitor.png';
import { teamMembers } from '../lib/team';
import '../styles/team-roster.css';
---
<section class="team-roster" aria-labelledby="team-title" data-team-roster data-no-split>
  <header class="team-roster__header">
    <h2 id="team-title">Nosotros</h2>
    <p class="team-roster__hint"><span class="team-roster__pointer-hint">Pasá por un nombre</span><span class="team-roster__touch-hint">Elegí un nombre</span><Icon name="down" /></p>
  </header>
  <div class="team-roster__stage flowing-team" data-flowing-team>
    <ol class="flowing-team__list" aria-label="Integrantes del equipo" data-team-list>
      {teamMembers.map((member, index) => (
        <li class="flowing-team__row" data-team-row>
          <h3><a class="flowing-team__choice" href={`#team-${member.id}`} data-team-choice data-team-index={index}>
            <span class="flowing-team__name" data-team-current-name>{member.name}</span>
            <span class="flowing-team__role" data-team-current-role>{member.role}</span>
            <span class="flowing-team__arrow" aria-hidden="true"><Icon /></span>
          </a></h3>
          <div class="flowing-team__band" data-team-band aria-hidden="true">
            <div class="flowing-team__track" data-team-track>
              {Array.from({length: 3}, () => (
                <div class="flowing-team__part" data-team-part>
                  <span class="flowing-team__marquee-name">{member.name}</span>
                  <span class="flowing-team__portrait">
                    <img class:list={{ 'flowing-team__portrait-placeholder': !member.portrait }} src={member.portrait ?? portraitPlaceholder.src} alt="" width="300" height="200" loading="lazy" decoding="async" style={{ 'object-position': member.portraitPosition ?? (member.portrait ? '50% 35%' : 'right') }} />
                    {!member.portrait && <span class="flowing-team__placeholder">Retrato provisorio</span>}
                  </span>
                  <span class="flowing-team__marquee-role">{member.role}</span>
                </div>
              ))}
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
  <div class="team-roster__profiles">
    {teamMembers.map(member => (
      <figure id={`team-${member.id}`} data-team-profile aria-label={`${member.name}, ${member.role}`}>
        <img src={member.portrait ?? portraitPlaceholder.src} alt={member.portrait ? `Retrato de ${member.name}` : 'Retrato alienígena de relleno, provisorio'} width="640" height="760" loading="lazy" decoding="async" />
        <figcaption>{member.name}<span>{member.role}</span>{!member.portrait && <small>Retrato provisorio</small>}{member.description && <p>{member.description}</p>}</figcaption>
      </figure>
    ))}
  </div>
  <div class="team-roster__footer"><span>La Plata Marketing</span><a href="#contacto">Sigamos en contacto <Icon name="down" /></a></div>
  <p class="team-roster__status" aria-live="polite" aria-atomic="true" data-team-status></p>
</section>
<script>
  import { initTeamRosters } from '../scripts/team-roster';
  initTeamRosters();
</script>
