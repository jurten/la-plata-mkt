---
import { Image, getImage } from 'astro:assets';
import portrait from '../assets/lpm-visitor.png';
import skinAlbedo from '../assets/lpm-alien-skin-albedo.png';
const skin=await getImage({src:skinAlbedo,width:1536,format:'webp',quality:92});
import '../styles/fonts.css';
export const prerender = true;
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex,nofollow" /><title>Alien model study · La Plata Marketing</title></head>
<body>
  <main>
    <a href="/">← Back to the website</a>
    <h1>More movement.<br />The same blue world.</h1>
    <p class="intro">The original portrait beside the refined, fully 3D character now used on the homepage. Drag the model to inspect its volume and surface.</p>
    <div class="studies">
      <figure><div class="art"><Image src={portrait} alt="The original detailed blue alien portrait" width={960} height={640} format="webp" /></div><figcaption><strong>Original portrait</strong><span>The visual reference and static fallback.</span></figcaption></figure>
      <figure><div class="art live"><canvas data-model-study data-skin-photo={skin.src} aria-label="Interactive blue-lit alien head model"></canvas><p data-model-status>Loading the rigged model…</p><div class="controls"><button type="button" data-model-motion aria-pressed="true">Pause movement</button><button type="button" data-model-reset>Reset view</button></div></div><figcaption><strong>Refined real 3D model</strong><span>Refined anatomy, fine skin relief and a real head-and-neck rig.</span></figcaption></figure>
    </div>
    <p class="source">Source: <a href="https://grab3d.com/models/characters/alien-grey/">Grab3D Grey Alien</a> · <a href="/models/alien-grey-LICENSE.txt">CC0 license and origin disclosure</a>. Geometry refinement, blue skin treatment and interaction by La Plata Marketing.</p>
  </main>
  <script>
    import '../scripts/alien-model-study';
  </script>
</body></html>
<style>
  :global(*){box-sizing:border-box} :global(body){margin:0;background:#020307;color:#eef3ff;font-family:'IBM Plex Sans',sans-serif}main{max-width:1440px;margin:auto;padding:36px 40px 56px}a{color:#b7d7ee}h1{font-family:'Radio Canada Big',sans-serif;font-size:clamp(42px,5vw,72px);line-height:1.02;letter-spacing:-.035em;margin:40px 0 22px}.intro{max-width:65ch;color:#b5c3df;line-height:1.65}.studies{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:36px}figure{margin:0;min-width:0}.art{height:560px;background:#000;position:relative;overflow:hidden;border:1px solid #29324b;border-radius:18px}.art img{width:100%;height:100%;object-fit:cover;object-position:100% 45%}.art canvas{width:100%;height:100%;display:block;touch-action:pan-y}.live>p{position:absolute;inset:45% 0 auto;text-align:center;color:#b5c3df;pointer-events:none}.controls{position:absolute;bottom:16px;left:16px;right:16px;display:flex;gap:8px;flex-wrap:wrap}button{font:inherit;color:#eef3ff;background:#0b1123;border:1px solid #7788ad;border-radius:10px;min-height:44px;padding:10px 15px;cursor:pointer}button:focus-visible,a:focus-visible{outline:3px solid #b7d7ee;outline-offset:4px}figcaption{display:flex;flex-direction:column;gap:8px;margin-top:20px}figcaption strong{font-family:'Radio Canada Big',sans-serif;font-size:26px}figcaption span,.source{color:#b5c3df;line-height:1.6}.source{margin-top:40px;font-size:14px}@media(max-width:800px){main{padding:24px 20px 40px}.studies{grid-template-columns:1fr;gap:36px}.art{height:480px}}
</style>
