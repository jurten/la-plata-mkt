---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/newsreader';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import { getCaseStudies } from '../lib/case-studies';
import { readRuntimeEnv } from '../lib/runtime-env';
import { parsePublicSiteUrl } from '../lib/site-origin';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';
import '../styles/global.css';

export const prerender = true;

const solutionPaths = [
  {
    number: '1',
    category: 'Presencia',
    title: 'Verse a la altura.',
    question: 'Mi negocio necesita verse más profesional.',
    tags: ['Web', 'Landing', 'Ecommerce', 'Modernización'],
    action: 'Mejorar mi presencia',
  },
  {
    number: '2',
    category: 'Captación',
    title: 'Generar consultas.',
    question: 'Necesito transformar visibilidad en oportunidades reales.',
    tags: ['Meta Ads', 'Landing', 'Medición', 'Optimización'],
    action: 'Generar consultas',
    featured: true,
  },
  {
    number: '3',
    category: 'Organización',
    title: 'Ordenar la operación.',
    question: 'Necesito centralizar clientes, consultas o procesos.',
    tags: ['CRM', 'Automatización', 'Integraciones', 'Turnos'],
    action: 'Ordenar mi operación',
  },
];

const systemNodes = [
  ['01 / ATRAER', 'Publicidad'],
  ['02 / RECIBIR', 'Web'],
  ['03 / CONVERTIR', 'Consulta', 'active'],
  ['04 / CONVERSAR', 'WhatsApp', 'human'],
  ['05 / REGISTRAR', 'CRM'],
  ['06 / SEGUIR', 'Proceso'],
  ['07 / RESULTADO', 'Venta'],
];

const methodSteps = [
  ['Entendemos', 'Nos contás cómo funciona hoy tu negocio y qué necesitás mejorar.'],
  ['Diagnosticamos', 'Identificamos el punto que frena el recorrido o desconecta las piezas.'],
  ['Proponemos', 'Definimos alcance, herramientas, tiempos y presupuesto con claridad.'],
  ['Implementamos', 'Construimos, conectamos y ponemos en funcionamiento la solución.'],
];

const capabilities = [
  ['Web', ['Sitios institucionales', 'Landing pages', 'Ecommerce', 'Mantenimiento']],
  ['Captación', ['Meta Ads', 'Setup de campañas', 'Medición', 'Optimización']],
  ['Sistemas', ['CRM', 'Automatizaciones', 'Integraciones', 'Turnos y herramientas']],
  ['Estrategia', ['Consultoría digital', 'Sistemas comerciales', 'Diseño de procesos', 'Diagnóstico']],
] as const;

const faqs = [
  ['¿Puedo contratar solamente una web?', 'Sí. No es necesario contratar varios servicios. Si una web resuelve el problema, el proyecto puede enfocarse solamente en eso.'],
  ['¿Con qué tipo de negocios trabajan?', 'Trabajamos con profesionales, empresas de servicios y PyMEs establecidas que necesitan mejorar su presencia, captación u operación digital.'],
  ['¿Cómo empieza un proyecto?', 'Con una conversación inicial y un diagnóstico. A partir de ahí definimos una propuesta concreta con alcance, tiempos y presupuesto.'],
  ['¿La primera reunión tiene costo?', 'No. La primera conversación sirve para entender el contexto y confirmar si La Plata Marketing puede aportar una solución adecuada.'],
  ['¿Cuánto demora un proyecto?', 'Depende del alcance y de las integraciones necesarias. La estimación queda definida en la propuesta antes de comenzar.'],
  ['¿Trabajan con proyectos puntuales?', 'Sí. Podemos resolver un proyecto con principio y fin —como una web o una implementación— y también acompañar procesos que requieren continuidad.'],
  ['¿Trabajan fuera de La Plata?', 'Sí. Trabajamos de forma remota con negocios de otras ciudades. Para proyectos locales, también podemos coordinar encuentros presenciales.'],
  ['¿Cuánto cuesta?', 'Cada propuesta se define según el problema, el alcance y las herramientas necesarias. Después del diagnóstico vas a recibir un presupuesto claro, sin servicios innecesarios.'],
];

const turnstileSiteKey =
  readRuntimeEnv('PUBLIC_TURNSTILE_SITE_KEY', import.meta.env.PUBLIC_TURNSTILE_SITE_KEY) ?? '';
const caseStudiesApproved =
  readRuntimeEnv('PUBLIC_CASE_STUDIES_APPROVED', import.meta.env.PUBLIC_CASE_STUDIES_APPROVED) ===
  'true';
const [realEstateCase, legalCase] = getCaseStudies(caseStudiesApproved);

const pageTitle = 'Marketing, tecnología y ventas como un sistema | La Plata Marketing';
const pageDescription =
  'La Plata Marketing conecta marketing, tecnología y ventas para que los negocios puedan crecer y organizarse.';
const publicSite = parsePublicSiteUrl(
  readRuntimeEnv('PUBLIC_SITE_URL', import.meta.env.PUBLIC_SITE_URL),
);
const canonicalUrl = publicSite ? new URL(Astro.url.pathname, publicSite) : undefined;
const ogImageUrl = publicSite ? new URL('/og-la-plata-marketing.png', publicSite) : undefined;
const allowIndexing = Boolean(publicSite);
const privacyHref = '/privacidad/';
const whatsappDisplay = '+54 9 11 5886-1954';
const whatsappHref = 'https://wa.me/5491158861954';
const contactEmail = 'ceo@laplatamarketing.com';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'La Plata Marketing',
  ...(canonicalUrl ? { url: canonicalUrl.toString() } : {}),
  email: contactEmail,
  description: pageDescription,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicios de marketing, tecnología y ventas',
    itemListElement: capabilities.map(([name, items], index) => ({
      '@type': 'Offer',
      position: index + 1,
      itemOffered: {
        '@type': 'Service',
        name,
        description: items.join(', '),
      },
    })),
  },
};
---
<!doctype html>
<html lang="es-AR" data-theme="auto">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta name="robots" content={allowIndexing ? 'index, follow' : 'noindex, nofollow'} />
    <meta name="theme-color" content="#F3EFE5" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" sizes="16x16 32x32 48x48 64x64" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="La Plata Marketing" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {ogImageUrl && (
      <>
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="La Plata Marketing: marketing, tecnología y ventas como un sistema" />
      </>
    )}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline></script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <header class="topbar">
      <div class="nav wrap">
        <a class="brand" href="#inicio" aria-label="La Plata Marketing, ir al inicio">
          <span class="brand-mark" aria-hidden="true">L/</span>
          <span>LPM</span>
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav">
          Menú
        </button>
        <nav class="primary-nav" id="primary-nav" aria-label="Navegación principal">
          <a href="#soluciones">Soluciones</a>
          <a href="#trabajo">Experiencia</a>
          <a href="#metodo">Método</a>
          <a href="#capacidades">Capacidades</a>
          <a class="button nav-cta" href="#contacto">Contanos qué necesitás <span aria-hidden="true">↗</span></a>
        </nav>
        <ThemeSwitcher />
      </div>
    </header>

    <main id="contenido">
      <section class="hero" id="inicio" aria-labelledby="hero-title">
        <div class="wrap hero-grid">
          <div>
            <p class="eyebrow">LPM / Marketing × Tecnología × Ventas</p>
            <h1 id="hero-title" class="display">Hacemos que todo trabaje como <em>un sistema.</em></h1>
          </div>
          <div class="hero-side">
            <p>Ayudamos a profesionales y negocios establecidos a mejorar su presencia digital, generar consultas y ordenar cómo gestionan sus clientes.</p>
            <div class="actions">
              <a class="button button-primary" href="#contacto">Contanos tu problema <span aria-hidden="true">↗</span></a>
              <a class="button button-outline" href="#sistema">Ver cómo trabajamos <span aria-hidden="true">↓</span></a>
            </div>
          </div>
        </div>
        <div class="wrap hero-ticker" aria-label="Principales resultados">
          <div class="ticker-cell"><b>01</b> Presencia que representa</div>
          <div class="ticker-cell"><b>02</b> Consultas que se pueden medir</div>
          <div class="ticker-cell"><b>03</b> Procesos que no dependen de memoria</div>
        </div>
      </section>

      <section id="problemas">
        <div class="wrap">
          <header class="section-head">
            <p class="eyebrow">01 / Reconocer</p>
            <div>
              <h2 class="display">Tu negocio funciona. ¿Su sistema digital también?</h2>
              <p class="section-intro muted">A veces el problema parece ser una web, una campaña o una planilla. Muchas veces es la forma en que esas piezas se conectan.</p>
            </div>
          </header>
          <div class="problems">
            <div class="problem-item"><span class="meta">01</span><p>Tu web ya no representa el nivel real de tu negocio.</p></div>
            <div class="problem-item"><span class="meta">02</span><p>Invertís en publicidad, pero no sabés qué pasa con las consultas.</p></div>
            <div class="problem-item"><span class="meta">03</span><p>Los clientes llegan por distintos canales y el seguimiento se dispersa.</p></div>
            <div class="problem-item"><span class="meta">04</span><p>Tu empresa creció, pero sus herramientas digitales no crecieron con ella.</p></div>
            <div class="problem-item"><span class="meta">05</span><p>Dependés demasiado de Instagram, WhatsApp o tareas manuales.</p></div>
            <div class="problem-item"><span class="meta">06</span><p>Sabés que podrías captar más, pero no tenés un recorrido claro.</p></div>
          </div>
          <p class="prompt">↓ Primero se reconoce el problema. Después se descubre el sistema.</p>
        </div>
      </section>

      <section id="soluciones">
        <div class="wrap">
          <header class="section-head">
            <p class="eyebrow">02 / Elegir un camino</p>
            <div>
              <h2 class="display">Empecemos por lo que necesitás lograr.</h2>
              <p class="section-intro muted">No hace falta conocer la herramienta correcta. Elegí la situación que más se parece a la tuya.</p>
            </div>
          </header>
          <div class="solution-paths">
            {solutionPaths.map((path) => (
              <article class:list={['solution-path', { featured: path.featured }]} data-number={path.number}>
                <p class="meta">{path.category}</p>
                <h3>{path.title}</h3>
                <p class="path-question">{path.question}</p>
                <div class="tags" aria-label={`Herramientas para ${path.category}`}>
                  {path.tags.map((tag) => <span class="tag">{tag}</span>)}
                </div>
                <a class:list={['button', { 'button-primary': path.featured, 'button-text': !path.featured }]} href="#contacto">
                  {path.action} <span aria-hidden="true">→</span>
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="system-section" id="sistema" aria-labelledby="system-title">
        <div class="wrap">
          <p class="eyebrow">03 / Hacer visible</p>
          <h2 id="system-title" class="display">Una herramienta sola rara vez resuelve todo el problema.</h2>
          <div class="system-copy">
            <p>Una campaña puede generar tráfico. Pero el tráfico necesita un lugar donde convertir. Una consulta necesita seguimiento. Y el seguimiento necesita un sistema.</p>
            <p>Por eso La Plata Marketing conecta marketing, tecnología y operación comercial. Intervenimos donde se corta la cadena.</p>
          </div>
          <div class="system-flow" role="group" aria-label="Flujo desde publicidad hasta venta">
            {systemNodes.map(([label, title, modifier]) => (
              <div class:list={['system-node', modifier]}>
                <b>{label}</b><span>{title}</span>
              </div>
            ))}
          </div>
          <p class="prompt">→ Hacer visible el sistema para poder intervenirlo.</p>
        </div>
      </section>

      <section id="trabajo" aria-labelledby="experience-title">
        <div class="wrap">
          <header class="section-head">
            <p class="eyebrow">04 / Experiencia</p>
            <div>
              <h2 id="experience-title" class="display">Experiencia aplicada a negocios reales.</h2>
              <p class="section-intro muted">Conocemos el recorrido completo: desde cómo llega una consulta hasta cómo se convierte en una relación comercial.</p>
            </div>
          </header>
          <div class="experience-grid">
            <article class="experience-card experience-real-estate">
              <div>
                <p class="meta">Sector 01 / Real estate</p>
                <p class="case-status">{realEstateCase.label}</p>
              </div>
              <div class="case-diagram" aria-hidden="true"></div>
              <h3 class="display">Demanda, atención y seguimiento.</h3>
              <p>{realEstateCase.summary}</p>
              <small>{realEstateCase.name}</small>
            </article>
            <article class="experience-card experience-professional">
              <div>
                <p class="meta">Sector 02 / Servicios profesionales</p>
                <p class="case-status">{legalCase.label}</p>
              </div>
              <h3 class="display">Credibilidad que convierte.</h3>
              <p>{legalCase.summary}</p>
              <small>{legalCase.name}</small>
              <a class="button button-text" href="#contacto">Tengo un proyecto parecido <span aria-hidden="true">→</span></a>
            </article>
          </div>
        </div>
      </section>

      <section id="metodo" aria-labelledby="method-title">
        <div class="wrap">
          <header class="section-head">
            <p class="eyebrow">05 / Método</p>
            <div>
              <h2 id="method-title" class="display">De un problema a una solución.</h2>
              <p class="section-intro muted">El proyecto no empieza eligiendo herramientas. Empieza entendiendo qué está pasando.</p>
            </div>
          </header>
          <ol class="method-steps">
            {methodSteps.map(([title, description]) => (
              <li class="method-step"><h3>{title}</h3><p>{description}</p></li>
            ))}
          </ol>
        </div>
      </section>

      <section id="capacidades" aria-labelledby="capabilities-title">
        <div class="wrap">
          <header class="section-head">
            <p class="eyebrow">06 / Capacidades</p>
            <div><h2 id="capabilities-title" class="display">Herramientas distintas para problemas distintos.</h2></div>
          </header>
          <div class="capability-grid">
            {capabilities.map(([title, items]) => (
              <article class="capability"><h3>{title}</h3><ul>{items.map((item) => <li>{item}</li>)}</ul></article>
            ))}
          </div>
          <p class="capability-note">No todos los negocios necesitan todo. Elegimos las herramientas en función del problema.</p>
        </div>
      </section>

      <section class="contact-section" id="contacto" aria-labelledby="contact-title">
        <div class="wrap contact-layout">
          <div class="contact-intro">
            <div class="contact-title">
              <p class="eyebrow">07 / Empecemos</p>
              <h2 id="contact-title" class="display">Contanos qué necesitás <em>resolver.</em></h2>
            </div>
            <div class="contact-side">
              <p>La primera reunión es gratuita. Vemos cómo funciona hoy tu negocio y evaluamos qué solución tiene sentido.</p>
              <a class="button contact-whatsapp" href={whatsappHref} aria-label={`Escribir a La Plata Marketing por WhatsApp al ${whatsappDisplay}`}>
                <span>Escribir por WhatsApp</span><strong>{whatsappDisplay}</strong><b aria-hidden="true">↗</b>
              </a>
            </div>
            <div class="contact-direct">
              <span class="meta">O escribinos por email</span>
              <a href={`mailto:${contactEmail}`}>{contactEmail} <b aria-hidden="true">↗</b></a>
            </div>
          </div>

          <form id="contact-form" class="contact-form" action="/api/contact" method="post" novalidate data-contact-form>
            <div class="contact-form-heading form-row-full">
              <p class="meta">Formulario de contacto</p>
              <h3>Tu consulta</h3>
            </div>
            <div class="form-row">
              <label for="company">Empresa</label>
              <input id="company" name="company" type="text" autocomplete="organization" minlength="2" maxlength="120" required />
              <span class="field-error" id="company-error"></span>
            </div>
            <div class="form-row">
              <label for="contactName">Nombre de contacto</label>
              <input id="contactName" name="contactName" type="text" autocomplete="name" minlength="2" maxlength="80" required />
              <span class="field-error" id="contactName-error"></span>
            </div>
            <div class="form-row">
              <label for="email">Email</label>
              <input id="email" name="email" type="email" autocomplete="email" inputmode="email" required />
              <span class="field-error" id="email-error"></span>
            </div>
            <div class="form-row">
              <label for="phone">Celular (opcional)</label>
              <input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="40" />
            </div>
            <div class="form-row form-row-full">
              <label for="issue">¿Qué problema querés resolver?</label>
              <textarea id="issue" name="issue" rows="5" minlength="20" maxlength="2000" required></textarea>
              <span class="field-error" id="issue-error"></span>
            </div>
            <div class="hp-field" aria-hidden="true">
              <label for="website">Sitio web</label>
              <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
            </div>
            <label class="consent form-row-full">
              <input name="privacyAccepted" type="checkbox" value="true" required />
              <span>Acepto que La Plata Marketing use mis datos para responder esta consulta. <a href={privacyHref}>Ver privacidad</a>.</span>
            </label>
            {turnstileSiteKey && (
              <div class="form-row-full turnstile-wrap"><div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div></div>
            )}
            <div class="form-status form-row-full" role="status" aria-live="polite" tabindex="-1"></div>
            <button class="submit-button form-row-full" type="submit">Enviar consulta <span aria-hidden="true">↗</span></button>
          </form>
        </div>
      </section>

      <section id="faq" aria-labelledby="faq-title">
        <div class="wrap">
          <header class="section-head">
            <p class="eyebrow">08 / Preguntas</p>
            <div><h2 id="faq-title" class="display">Antes de conversar.</h2></div>
          </header>
          <div class="faq-list">
            {faqs.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <a class="footer-brand" href="#inicio" aria-label="La Plata Marketing, volver arriba">LPM</a>
          <div><h3>Soluciones</h3><a href="#soluciones">Presencia</a><a href="#soluciones">Captación</a><a href="#soluciones">Organización</a></div>
          <div><h3>Explorar</h3><a href="#sistema">Sistema</a><a href="#trabajo">Experiencia</a><a href="#metodo">Método</a><a href={privacyHref}>Privacidad</a></div>
          <div><h3>Contacto</h3><a href={whatsappHref} aria-label={`Escribir a La Plata Marketing por WhatsApp al ${whatsappDisplay}`}>WhatsApp</a><a href={`mailto:${contactEmail}`}>{contactEmail}</a><a href="#inicio">Volver arriba ↑</a></div>
        </div>
        <div class="footer-bottom"><span>© 2026 LPM / La Plata, Argentina</span><span id="mode-label">Identidad visual / Sistema automático</span></div>
      </div>
    </footer>

    <script is:inline src="/scripts/site.js" defer></script>
    {turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  </body>
</html>
