---
import '../styles/fonts.css';
import { readRuntimeEnv } from '../lib/runtime-env';
import { parsePublicSiteUrl } from '../lib/site-origin';
import TelevisionNavigation from '../components/TelevisionNavigation.astro';
import Icon from '../components/Icon.astro';
import AtmosphereHero from '../components/AtmosphereHero.astro';
import PerspectiveStudy from '../components/PerspectiveStudy.astro';
import PortfolioReveal from '../components/PortfolioReveal.astro';
import TeamRoster from '../components/TeamRoster.astro';
import ServicesSection from '../components/ServicesSection.astro';
import ContactFooter from '../components/ContactFooter.astro';
import HeroReveal from '../components/HeroReveal.astro';
import '../styles/global.css';
import '../styles/alien.css';
import '../styles/system-orbit.css';
import '../styles/retro-cursor.css';
import '../styles/floating-whatsapp.css';
import '../styles/brand.css';
import '../styles/contact-footer.css';

export const prerender = true;

const solutionPaths = [
  {
    number: '1',
    category: 'Presencia',
    title: 'Verse a la altura.',
    question: 'Mi negocio necesita verse más profesional.',
    tags: ['Web', 'Landing', 'Ecommerce', 'Modernización'],
    action: 'Mejorar mi presencia',
  },
  {
    number: '2',
    category: 'Captación',
    title: 'Generar consultas.',
    question: 'Necesito transformar visibilidad en oportunidades reales.',
    tags: ['Meta Ads', 'Landing', 'Medición', 'Optimización'],
    action: 'Generar consultas',
  },
  {
    number: '3',
    category: 'Organización',
    title: 'Ordenar la operación.',
    question: 'Necesito centralizar clientes, consultas o procesos.',
    tags: ['CRM', 'Automatización', 'Integraciones', 'Turnos'],
    action: 'Ordenar mi operación',
  },
];

const capabilities = [
  ['Web', ['Sitios institucionales', 'Landing pages', 'Ecommerce', 'Mantenimiento']],
  ['Captación', ['Meta Ads', 'Setup de campañas', 'Medición', 'Optimización']],
  ['Sistemas', ['CRM', 'Automatizaciones', 'Integraciones', 'Turnos y herramientas']],
  ['Estrategia', ['Consultoría digital', 'Sistemas comerciales', 'Diseño de procesos', 'Diagnóstico']],
] as const;

const pageTitle = 'Marketing, tecnología y ventas como un sistema | La Plata Marketing';
const pageDescription =
  'La Plata Marketing conecta marketing, tecnología y ventas para que los negocios puedan crecer y organizarse.';
const publicSite = parsePublicSiteUrl(
  readRuntimeEnv('PUBLIC_SITE_URL', import.meta.env.PUBLIC_SITE_URL),
);
const canonicalUrl = publicSite ? new URL(Astro.url.pathname, publicSite) : undefined;
const ogImageUrl = publicSite ? new URL('/og-la-plata-marketing.png', publicSite) : undefined;
const allowIndexing = Boolean(publicSite);
const privacyHref = '/privacidad/';
const whatsappDisplay = '+54 9 11 5886-1954';
const whatsappHref = 'https://wa.me/5491158861954';
const contactEmail = 'ceo@laplatamarketing.com';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'La Plata Marketing',
  ...(canonicalUrl ? { url: canonicalUrl.toString() } : {}),
  ...(publicSite ? { logo: new URL('/brand/lpm-profile.png', publicSite).toString() } : {}),
  email: contactEmail,
  description: pageDescription,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicios de marketing, tecnología y ventas',
    itemListElement: capabilities.map(([name, items], index) => ({
      '@type': 'Offer',
      position: index + 1,
      itemOffered: {
        '@type': 'Service',
        name,
        description: items.join(', '),
      },
    })),
  },
};
---
<!doctype html>
<html lang="es-AR" data-theme="auto">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta name="robots" content={allowIndexing ? 'index, follow' : 'noindex, nofollow'} />
    <meta name="theme-color" content="#EEF2FF" />
    <script is:inline src="/scripts/theme-init.js"></script>
    <link rel="icon" href="/favicon.svg?v=20261110" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico?v=20261110" type="image/x-icon" sizes="16x16 32x32 48x48 64x64" />
    <link rel="apple-touch-icon" href="/brand/lpm-profile.png" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="La Plata Marketing" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {ogImageUrl && (
      <>
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="La Plata Marketing: marketing, tecnología y ventas como un sistema" />
      </>
    )}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline></script>
  </head>
  <body class="site-home">
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <TelevisionNavigation />
    <main id="contenido">
      <HeroReveal>
      <section slot="hero" class="hero alien-hero optical-hero" id="inicio" aria-labelledby="hero-title">
        <AtmosphereHero />
        <div class="wrap hero-stage">
          <div class="hero-copy">
            <div class="optical-heading" data-warp-text>
              <h1 id="hero-title"><span>Somos un equipo </span><span>con ideas de </span><span>otro planeta</span></h1>
            </div>
            <div class="actions"><a class="button button-primary button-mimas" href={whatsappHref}><span>Hablemos por WhatsApp</span><Icon /></a></div>
          </div>
        </div>
        <div class="hero-footer wrap">
          <p class="optical-footer-copy">Desde La Plata.<br />Otra forma de mirar.</p>
          <a class="hero-scroll-cue" href="#soluciones">Descubrí nuestro enfoque <Icon name="down" /></a>
          <p class="optical-footer-copy">Marketing, tecnología<br />y las ideas que los conectan.</p>
        </div>
      </section>

      <ServicesSection capabilities={capabilities} solutionPaths={solutionPaths} whatsappHref={whatsappHref} />
      </HeroReveal>

      <section class="system-section" id="sistema" aria-labelledby="system-title">
        <PerspectiveStudy />
      </section>

      <PortfolioReveal whatsappHref={whatsappHref}>
      <section id="nosotros" class="about-section"><div class="wrap">
        <TeamRoster />
      </div></section>

      </PortfolioReveal>

    </main>
    <ContactFooter {whatsappHref} {whatsappDisplay} {contactEmail} {privacyHref} />
    <a class="floating-whatsapp" href={whatsappHref} aria-label={`Escribir a La Plata Marketing por WhatsApp al ${whatsappDisplay}`} title="Escribir por WhatsApp" data-floating-whatsapp hidden><span class="whatsapp-visual"><svg class="whatsapp-splash" viewBox="-36 -36 72 72" aria-hidden="true" focusable="false"><path data-whatsapp-contour d="M28 0A28 28 0 1 1-28 0A28 28 0 1 1 28 0Z" /></svg><svg viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path d="M16.04 3A12.92 12.92 0 0 0 5.1 22.78L3 29l6.43-2.02A12.96 12.96 0 1 0 16.04 3Zm0 2.6a10.35 10.35 0 1 1-5.99 18.8l-.47-.33-3.07.96 1-2.96-.36-.5A10.33 10.33 0 0 1 16.04 5.6Zm-4.55 4.62c-.2 0-.53.08-.81.39-.28.3-1.07 1.04-1.07 2.54s1.1 2.95 1.24 3.15c.15.2 2.14 3.43 5.3 4.68 2.62 1.04 3.16.83 3.73.78.57-.05 1.84-.75 2.1-1.48.26-.73.26-1.35.18-1.48-.07-.13-.28-.2-.59-.36-.3-.16-1.83-.91-2.12-1.01-.28-.1-.49-.16-.7.15-.2.31-.8 1.02-.98 1.22-.18.21-.36.23-.67.08-.3-.16-1.29-.48-2.46-1.52a9.2 9.2 0 0 1-1.7-2.12c-.17-.3-.01-.47.14-.62.14-.14.3-.36.46-.54.15-.18.2-.31.3-.52.11-.2.06-.39-.02-.54-.08-.16-.69-1.67-.95-2.29-.25-.6-.51-.52-.7-.53h-.65Z" /></svg></span></a>
    <script>import '../scripts/floating-whatsapp'; import '../scripts/text-reveal';</script>
    <script is:inline src="/scripts/site.js" defer></script>
    <script is:inline type="text/javascript" id="hs-script-loader" async defer src="https://js.hs-scripts.com/52086486.js"></script>
  </body>
</html>
